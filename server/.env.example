# Copy this file to .env and fill in the values. Never commit .env.
PORT=5001
# Random string used to sign login tokens. See the README for a one-line generator.
JWT_SECRET=
ADMIN_USERNAME=admin
# bcrypt hash of your admin password, wrapped in single quotes. See the README.
ADMIN_PASSWORD_HASH=''

# Optional: email customers when a booking is confirmed or cancelled.
# Leave blank and the server just logs what it would have sent. See the README.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
